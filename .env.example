# Porta exposta no host
HOST_PORT=8000

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Quantidade de workers do Uvicorn (Recomendado 1 ou 2 por container devido ao uso de memória de Deep Learning)
WORKERS=1

# Integração com Google Drive (true para ambiente mockado de teste, false para produção)
USE_GOOGLE_DRIVE_MOCK=true

# Caminho para credencial Service Account do Google Drive (opcional, montado em volume)
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/service-account.json

